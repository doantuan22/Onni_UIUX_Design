{
  "schema_version": 1,
  "description": "Single packaging contract. Selection: a file is packaged when its architecture layer (uiux/core/layers.json) has package=true, its layer is not in exclude_layers, no path segment is in exclude_dirs and it matches no exclude_glob. Unclassified files fail. must_include lists files every artifact MUST contain; must_exclude_prefixes are forbidden even if a layer rule changes. 'artifact' defines the archive metadata used by build.py and verify.py.",
  "exclude_layers": [
    "tests",
    "development",
    "artifact-metadata"
  ],
  "exclude_dirs": [
    ".git",
    ".github",
    "__pycache__",
    "node_modules",
    ".evidence",
    ".pytest_cache",
    ".mypy_cache",
    ".venv",
    "venv",
    ".tox",
    "dist",
    "build",
    ".staging",
    ".idea",
    ".vscode"
  ],
  "exclude_globs": [
    "**/*.pyc",
    "**/*.pyo",
    "**/*.tmp",
    "**/*.log",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/*.egg-info/**",
    "evals/benchmark/output/**",
    "evals/results/**",
    "**/benchmark-output/**",
    "**/.evidence/**",
    "**/runtime-helper.cjs",
    "**/runtime-input.json",
    "**/axe-helper.cjs",
    "**/axe-input.json",
    "**/*.staging/**",
    "uiux.config.json"
  ],
  "must_include": [
    "SKILL.md",
    "VERSION",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "uiux/__init__.py",
    "uiux/api.py",
    "uiux/cli.py",
    "uiux/core/defaults.json",
    "uiux/core/tools.json",
    "uiux/core/layers.json",
    "uiux/core/errors.json",
    "uiux/core/errors.py",
    "uiux/core/schema.py",
    "uiux/core/capabilities.json",
    "uiux/core/registry.py",
    "uiux/core/resources.py",
    "uiux/core/config.py",
    "knowledge/domains/registry.json",
    "knowledge/domains/INDEX.md",
    "execution/viewports.json",
    "evals/fixtures/quality/expectations.json",
    "plugin.json",
    "schemas/plugin.schema.json",
    "schemas/package-manifest.schema.json",
    "schemas/adapter.schema.json",
    "adapters/generic/adapter.py",
    "adapters/generic/adapter.json",
    "adapters/mcp/__init__.py",
    "adapters/mcp/protocol.py",
    "adapters/mcp/server.py",
    "adapters/mcp/adapter.json",
    "adapters/mcp/README.md",
    "packaging/package-rules.json",
    "packaging/package_files.py",
    "packaging/artifact.py",
    "packaging/verify.py",
    "scripts/_bootstrap.py",
    "scripts/uiux_cli.py",
    "scripts/validate_skill.py",
    "scripts/knowledge_lib.py",
    "scripts/resolve_capabilities.py",
    "scripts/analyze_design_quality.py",
    "scripts/run_browser_execution.py",
    "scripts/detect_capabilities.py",
    "scripts/run_accessibility_scan.py",
    "scripts/validate_runtime_evidence.py",
    "scripts/validate_accessibility_evidence.py"
  ],
  "must_exclude_prefixes": [
    "dist/",
    "build/"
  ],
  "artifact": {
    "format_version": 1,
    "formats": [
      "zip",
      "tar.gz"
    ],
    "metadata_file": "PACKAGE-MANIFEST.json",
    "dev_suffix": "-dev",
    "release_dir": "dist/{version}",
    "dev_dir": "dist/dev/{version}",
    "file_mode": "0644",
    "compression_level": 9,
    "dev_source_date_epoch": 315619200,
    "text_normalization": "lf",
    "binary_globs": [
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.avif",
      "**/*.ico",
      "**/*.pdf",
      "**/*.zip",
      "**/*.gz",
      "**/*.woff",
      "**/*.woff2",
      "**/*.ttf",
      "**/*.otf"
    ]
  }
}
