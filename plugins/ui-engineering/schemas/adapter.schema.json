{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adapter metadata (plugins/ui-engineering/adapters/<id>/adapter.json)",
  "description": "Declarative adapter metadata (spec section 7.2). Data only: every reference points to a uiux.api function, never to internal modules. Platform adapters add host metadata only through the optional 'host', 'rendered_files' and 'bundle_layout' fields.",
  "type": "object",
  "required": ["schema_version", "id", "status", "adapter_contract_version", "core_api", "manifest_version", "transports",
               "tools", "knowledge", "runtime", "errors", "capability_discovery"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "status": {"enum": ["planned", "skeleton", "experimental", "supported"]},
    "description": {"type": "string", "minLength": 1},
    "adapter_contract_version": {"const": 1},
    "core_api": {
      "type": "object",
      "required": ["module", "plugin_api_version", "core_version"],
      "additionalProperties": false,
      "properties": {
        "module": {"const": "uiux.api"},
        "plugin_api_version": {"type": "integer", "minimum": 1},
        "core_version": {"type": "string", "pattern": "^(>=|>|<=|<|==)\\d+\\.\\d+\\.\\d+(,(>=|>|<=|<|==)\\d+\\.\\d+\\.\\d+)*$"}
      }
    },
    "manifest_version": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "transports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["python", "cli-json", "mcp-stdio"]}},
    "tools": {
      "type": "object",
      "required": ["exposure", "tool_map", "source", "invoke"],
      "additionalProperties": false,
      "properties": {
        "exposure": {"enum": ["all-public", "listed"]},
        "exposed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "tool_map": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"}},
        "source": {"const": "uiux.api.list_tools"},
        "invoke": {"const": "uiux.api.call_tool"}
      }
    },
    "knowledge": {
      "type": "object",
      "required": ["exposure", "access", "rule"],
      "additionalProperties": false,
      "properties": {
        "exposure": {"enum": ["progressive"]},
        "access": {"type": "array", "minItems": 1, "items": {"enum": ["retrieve_knowledge"]}},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["optional", "detection", "blocked_is_result", "installs_dependencies", "downloads_browsers"],
      "additionalProperties": false,
      "properties": {
        "optional": {"const": true},
        "detection": {"enum": ["on-demand"]},
        "blocked_is_result": {"const": true},
        "installs_dependencies": {"const": false},
        "downloads_browsers": {"const": false}
      }
    },
    "errors": {
      "type": "object",
      "required": ["error_contract_version", "source", "envelope"],
      "additionalProperties": false,
      "properties": {
        "error_contract_version": {"type": "integer", "minimum": 1},
        "source": {"const": "uiux.api.error_contract"},
        "envelope": {"type": "array", "minItems": 1, "uniqueItems": true,
                     "items": {"enum": ["status", "error", "error_code", "category", "remediation", "details"]}}
      }
    },
    "capability_discovery": {
      "type": "object",
      "required": ["capability_map", "self_test"],
      "additionalProperties": false,
      "properties": {
        "capability_map": {"const": "uiux.api.capability_map"},
        "self_test": {"const": "uiux.api.self_test"}
      }
    },
    "protocol": {
      "type": "object",
      "required": ["version", "methods"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "host": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "min_version": {"type": "string"},
        "docs_checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "rendered_files": {
      "type": "array",
      "items": {"type": "object", "required": ["template", "target"], "additionalProperties": false,
                "properties": {"template": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}}
    },
    "bundle_layout": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
