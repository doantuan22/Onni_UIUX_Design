{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uiux.local/schemas/existing-ui-profile.schema.json",
  "title": "ExistingUIProfile",
  "description": "Normalized machine-readable profile of existing UI identity, layout, component consistency, UX flows, responsive and accessibility health.",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "layout",
    "components",
    "ux",
    "responsive",
    "accessibility",
    "design_system",
    "diagnostics",
    "overall_confidence",
    "visual_analysis",
    "understanding_gate"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "identity": {
      "type": "object",
      "required": ["colors", "typography", "radius", "shadows", "density", "visual_language", "confidence", "evidence"],
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "primary": {"type": ["string", "null"]},
            "secondary": {"type": ["string", "null"]},
            "accent": {"type": ["string", "null"]},
            "neutral": {"type": "array", "items": {"type": "string"}},
            "background": {"type": ["string", "null"]},
            "surface": {"type": ["string", "null"]},
            "text": {"type": ["string", "null"]},
            "semantic": {
              "type": "object",
              "properties": {
                "success": {"type": ["string", "null"]},
                "warning": {"type": ["string", "null"]},
                "error": {"type": ["string", "null"]},
                "info": {"type": ["string", "null"]}
              }
            }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "font_family_base": {"type": ["string", "null"]},
            "font_family_heading": {"type": ["string", "null"]},
            "font_family_mono": {"type": ["string", "null"]},
            "scale": {"type": "array", "items": {"type": "string"}},
            "weights": {"type": "array", "items": {"type": "string"}}
          }
        },
        "radius": {
          "type": "object",
          "properties": {
            "default": {"type": ["string", "null"]},
            "scale": {"type": "array", "items": {"type": "string"}}
          }
        },
        "shadows": {
          "type": "object",
          "properties": {
            "scale": {"type": "array", "items": {"type": "string"}}
          }
        },
        "density": {
          "type": "string",
          "enum": ["compact", "normal", "spacious", "unknown"]
        },
        "visual_language": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["container_patterns", "grid_patterns", "spacing_rhythm", "section_hierarchy", "navigation_structure", "global_structure", "local_structure", "confidence", "evidence"],
      "properties": {
        "container_patterns": {"type": "array", "items": {"type": "string"}},
        "grid_patterns": {"type": "array", "items": {"type": "string"}},
        "spacing_rhythm": {"type": ["string", "null"]},
        "section_hierarchy": {"type": "array", "items": {"type": "string"}},
        "navigation_structure": {
          "type": "object",
          "properties": {
            "type": {"type": "string"},
            "placement": {"type": ["string", "null"]},
            "items": {"type": "array", "items": {"type": "string"}}
          }
        },
        "responsive_breakpoints": {"type": "array", "items": {"type": "string"}},
        "global_structure": {
          "type": "object",
          "properties": {
            "app_shell": {"type": ["string", "null"]},
            "header": {"type": ["string", "null"]},
            "sidebar": {"type": ["string", "null"]},
            "footer": {"type": ["string", "null"]},
            "main_container": {"type": ["string", "null"]}
          }
        },
        "local_structure": {
          "type": "object",
          "properties": {
            "card_patterns": {"type": "array", "items": {"type": "string"}},
            "form_patterns": {"type": "array", "items": {"type": "string"}},
            "section_patterns": {"type": "array", "items": {"type": "string"}}
          }
        },
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "components": {
      "type": "object",
      "required": ["variants", "consistency", "shared_patterns", "anomalies", "severity", "confidence", "evidence"],
      "properties": {
        "variants": {"type": "object"},
        "consistency": {"type": "string", "enum": ["high", "moderate", "low", "inconsistent", "unknown"]},
        "shared_patterns": {"type": "array", "items": {"type": "string"}},
        "anomalies": {"type": "array", "items": {"type": "string"}},
        "canonical_patterns": {"type": "object"},
        "duplicate_signals": {"type": "array", "items": {"type": "string"}},
        "component_graph": {"type": "object"},
        "severity": {"type": "string", "enum": ["info", "low", "medium", "high"]},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ux": {
      "type": "object",
      "required": ["flows", "states", "missing_states", "friction_signals", "confidence", "evidence"],
      "properties": {
        "flows": {"type": "array", "items": {"type": "string"}},
        "states": {"type": "array", "items": {"type": "string"}},
        "missing_states": {"type": "array", "items": {"type": "string"}},
        "friction_signals": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "responsive": {
      "type": "object",
      "required": ["breakpoints", "layout_adaptations", "possible_overflow", "touch_target_signals", "mobile_navigation", "content_priority", "risks", "severity", "confidence", "evidence"],
      "properties": {
        "breakpoints": {"type": "array", "items": {"type": "string"}},
        "layout_adaptations": {"type": "array", "items": {"type": "string"}},
        "possible_overflow": {"type": "array", "items": {"type": "string"}},
        "touch_target_signals": {"type": "array", "items": {"type": "string"}},
        "mobile_navigation": {"type": ["string", "null"]},
        "content_priority": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "severity": {"type": "string", "enum": ["info", "low", "medium", "high"]},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["labels", "semantics", "focus", "keyboard", "contrast_signals", "confidence", "evidence"],
      "properties": {
        "labels": {"type": "array", "items": {"type": "string"}},
        "semantics": {"type": "array", "items": {"type": "string"}},
        "focus": {"type": "array", "items": {"type": "string"}},
        "keyboard": {"type": "array", "items": {"type": "string"}},
        "contrast_signals": {"type": "array", "items": {"type": "string"}},
        "missing_form_labels": {"type": "array", "items": {"type": "string"}},
        "heading_hierarchy_issues": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "design_system": {
      "type": "object",
      "required": ["tokens", "component_conventions", "typography_scale", "spacing_scale", "radius_scale", "semantic_colors", "maturity", "confidence", "evidence"],
      "properties": {
        "tokens": {"type": "object"},
        "component_conventions": {"type": "object"},
        "typography_scale": {"type": "array", "items": {"type": "string"}},
        "spacing_scale": {"type": "array", "items": {"type": "string"}},
        "radius_scale": {"type": "array", "items": {"type": "string"}},
        "semantic_colors": {"type": "object"},
        "maturity": {
          "type": "string",
          "enum": ["mature", "partial", "fragmented", "unknown"]
        },
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["warnings", "unsupported_analysis", "analyzer_failures"],
      "properties": {
        "warnings": {"type": "array", "items": {"type": "string"}},
        "unsupported_analysis": {"type": "array", "items": {"type": "string"}},
        "analyzer_failures": {"type": "array", "items": {"type": "string"}}
      }
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "visual_analysis": {
      "type": "object",
      "required": ["measured", "inferred", "model_interpretable_evidence", "confidence"],
      "properties": {
        "measured": {"type": "object"},
        "inferred": {"type": "object"},
        "model_interpretable_evidence": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "understanding_gate": {
      "type": "object",
      "required": ["status", "missing_context", "required_next_actions", "confidence"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "PARTIAL", "BLOCKED"]},
        "missing_context": {"type": "array", "items": {"type": "string"}},
        "required_next_actions": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    }
  }
}
