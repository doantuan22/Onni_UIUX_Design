{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PACKAGE-MANIFEST.json: identity, provenance and file hashes of a built artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "archive_format_version",
    "name",
    "skill_name",
    "python_package",
    "version",
    "manifest_version",
    "build_mode",
    "release",
    "source",
    "source_date_epoch",
    "rules_sha256",
    "file_count",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "archive_format_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Package id owned by plugins/ui-engineering/plugin.json"
    },
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "description": "Skill name owned by SKILL.md frontmatter"
    },
    "python_package": {
      "const": "uiux"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "description": "Copied from VERSION"
    },
    "manifest_version": {
      "type": "integer",
      "minimum": 1
    },
    "build_mode": {
      "enum": [
        "release",
        "dev"
      ]
    },
    "release": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commit",
        "worktree_clean"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git-archive",
            "working-tree"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_clean": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "rules_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256",
          "layer",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "layer": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "const": "0644"
          }
        }
      }
    }
  }
}
