# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Runtime evidence, browser captures and helper temporaries (generated by scripts/run_browser_execution.py)
.evidence/
**/runtime-helper.cjs
**/runtime-input.json
**/axe-helper.cjs
**/axe-input.json

# Benchmark and eval outputs
evals/benchmark/output/
evals/results/

# Local configuration, build outputs and packaging staging (plugin/packaging/build.py stages in the system temp dir;
# these patterns guard against manual or aborted builds inside the repository)
uiux.config.json
dist/
build/
# Local build outputs and throwaway scripts (never committed; releases are built by .github/workflows/package.yml)
/out/
/scratch/
.staging/
*.staging/
*.egg-info/
.coverage
htmlcov/
.tox/
.idea/
.vscode/
node_modules/
*.log
*.tmp
.DS_Store
Thumbs.db
